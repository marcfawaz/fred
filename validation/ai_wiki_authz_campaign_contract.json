      "shadow_legacy_expected_denied": ["alice", "gabriel", "oscar"]
    },
    {
      "key": "contribution_capability_assertion",
      "method": "GET",
      "path": "/wiki/v1/teams/{team_id}/permissions/can_contribute_wikis",
      "capability": "can_contribute_wikis",
      "mutating": false,
      "allowed": ["bob", "priya"],
      "denied": ["marc", "elena", "zoe", "alice", "gabriel", "oscar"],
      "accepted_authorized_statuses": [200],
      "accepted_denied_statuses": [403],
      "shadow_legacy_expected_allowed": ["marc", "bob", "elena", "zoe", "priya"],
      "shadow_legacy_expected_denied": ["alice", "gabriel", "oscar"],
      "notes": "non-mutating probe proves team_admin does not imply team_editor under direct OpenFGA"
    },
    {
      "key": "review_collection",
      "method": "GET",
      "path": "/wiki/v1/wikis/{wiki_id}/merge-proposals",
      "capability": "can_review_wiki_changes",
      "mutating": false,
      "allowed": ["marc", "priya"],
      "denied": ["bob", "elena", "zoe", "alice", "gabriel", "oscar"],
      "accepted_authorized_statuses": [200],
      "accepted_denied_statuses": [403, 404],
      "shadow_legacy_expected_allowed": ["marc", "bob", "elena", "zoe", "priya"],
      "shadow_legacy_expected_denied": ["alice", "gabriel", "oscar"]
    },
    {
      "key": "schema_management_collection",
      "method": "GET",
      "path": "/wiki/v1/wikis/{wiki_id}/schema-proposals",
      "capability": "can_manage_wiki_schema",
      "mutating": false,
      "allowed": ["marc", "priya"],
      "denied": ["bob", "elena", "zoe", "alice", "gabriel", "oscar"],
      "accepted_authorized_statuses": [200],
      "accepted_denied_statuses": [403, 404],
      "shadow_legacy_expected_allowed": ["marc", "bob", "elena", "zoe", "priya"],
      "shadow_legacy_expected_denied": ["alice", "gabriel", "oscar"],
