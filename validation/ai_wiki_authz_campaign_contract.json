      "key": "read_list",
      "method": "GET",
      "path": "/wiki/v1/wikis?scope_type=team&team_id={team_id}",
      "capability": "can_read_wikis",
      "mutating": false,
      "allowed": ["marc", "bob", "elena", "zoe", "priya"],
      "denied": ["alice", "gabriel", "oscar"],
      "accepted_authorized_statuses": [200],
      "accepted_denied_statuses": [403, 404],
      "shadow_legacy_expected_allowed": ["marc", "bob", "elena", "zoe", "priya"],
      "shadow_legacy_expected_denied": ["alice", "gabriel", "oscar"]
    },
    {
      "key": "read_pages",
      "method": "GET",
      "path": "/wiki/v1/wikis/{wiki_id}/pages",
      "capability": "can_read_wikis",
      "mutating": false,
      "allowed": ["marc", "bob", "elena", "zoe", "priya"],
      "denied": ["alice", "gabriel", "oscar"],
      "accepted_authorized_statuses": [200],
      "accepted_denied_statuses": [403, 404],
