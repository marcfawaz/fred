    },
    {
      "key": "lifecycle_update_disposable",
      "method": "PATCH",
      "path": "/wiki/v1/wikis/{wiki_id}",
      "capability": "can_manage_wiki_lifecycle",
      "mutating": true,
      "allowed": ["marc", "priya"],
      "denied": ["bob", "elena", "zoe", "alice", "gabriel", "oscar"],
      "accepted_authorized_statuses": [200],
      "accepted_denied_statuses": [403, 404],
      "shadow_legacy_expected_allowed": ["marc", "bob", "elena", "zoe", "priya"],
      "shadow_legacy_expected_denied": ["alice", "gabriel", "oscar"],
      "cleanup_resource_types_produced": [],
      "body": {"description": "{marker} lifecycle authorization probe"}
    },
    {
      "key": "governance_get",
      "method": "GET",
      "path": "/wiki/v1/wikis/{wiki_id}/settings/governance/review-assistance",
